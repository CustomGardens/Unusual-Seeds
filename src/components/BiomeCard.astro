---
import type { Biome } from "../data/biomes";

interface Props {
  biome: Biome;
  index: number;
}

const { biome, index } = Astro.props;
const numerals = ["I", "II", "III", "IV", "V"];
const isFirst = index === 0;
---

<article class="biome-card group">
  {
    isFirst && (
      <p class="mb-3 text-[0.6rem] tracking-[0.18em] text-window-glow/50 uppercase">
        Issue 01 — Spring
      </p>
    )
  }
  <div class="flex items-baseline justify-between gap-3">
    <span class="font-serif text-sm text-parchment-faint" aria-hidden="true">
      {numerals[index]}
    </span>
    <span class="text-[0.6rem] tracking-wider text-parchment-faint uppercase">Biome</span>
  </div>

  <h3 class="mt-2 text-base leading-snug">
    <a href={`/biomes/${biome.slug}`} class="hover:text-parchment/90">
      {biome.title}
    </a>
  </h3>

  <p class="mt-2 flex-1 text-sm leading-relaxed text-parchment-muted">
    {biome.description}
  </p>

  <p class="mt-2 text-sm italic text-parchment-faint">
    {biome.cardNote}
  </p>

  <a
    href={`/biomes/${biome.slug}`}
    class="mt-3 text-xs tracking-wide text-accent hover:text-parchment"
  >
    Explore →
  </a>
</article>
