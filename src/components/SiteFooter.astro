---
const topics = [
  "Botanical hybrids",
  "Imagined worlds",
  "Quiet technologies",
  "Rare specimens",
];
---

<footer class="border-t border-parchment/10 bg-ink-soft">
  <div class="mx-auto max-w-5xl px-5 py-7">
    <p class="text-center text-[0.65rem] tracking-[0.12em] text-parchment-faint">
      {topics.join(" · ")}
    </p>
    <p class="mt-2 text-center text-sm text-parchment-muted">Ideas worth growing.</p>
  </div>
</footer>
