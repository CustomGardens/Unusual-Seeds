---
import type { Pathway } from "../data/pathways";
import { pathwayHref } from "../data/pathways";

interface Props {
  pathway: Pathway;
}

const { pathway } = Astro.props;
---

<a
  href={pathwayHref(pathway)}
  class="pathway-plaque group"
  aria-label={`${pathway.label}: ${pathway.hint}`}
>
  <span class="pathway-plaque__label">{pathway.label}</span>
  <span class="pathway-plaque__hint" aria-hidden="true">{pathway.hint}</span>
</a>
