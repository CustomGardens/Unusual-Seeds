---
import { isImmersivePath } from "../data/immersive-pages";

const navPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = navPath === "/";
const isImmersive = isImmersivePath(navPath);
---

<header
  class:list={[
    "z-20",
    isImmersive
      ? "absolute inset-x-0 top-0 border-transparent bg-transparent"
      : "border-b border-parchment/10 bg-ink/95 backdrop-blur-sm",
  ]}
>
  <nav
    class:list={[
      "mx-auto flex max-w-5xl items-center gap-6 px-5 py-4",
      isHome ? "justify-end" : "justify-between",
    ]}
    aria-label="Main"
  >
    {
      !isHome && (
        <a
          href="/"
          class="font-serif text-sm tracking-wide text-parchment/70 hover:text-parchment"
        >
          Unusual Seeds
        </a>
      )
    }

    <ul class="flex items-center gap-5 text-xs tracking-[0.14em] text-parchment-muted uppercase">
      <li>
        <a
          href="/about"
          class:list={[
            "nav-about hover:text-parchment/90 focus-visible:text-parchment/90",
            navPath === "/about" && "text-parchment",
          ]}
        >
          About
        </a>
      </li>
    </ul>
  </nav>
</header>
