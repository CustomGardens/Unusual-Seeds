---
import BaseLayout from "../layouts/BaseLayout.astro";
import WingExhibits from "../components/WingExhibits.astro";
import { rarePaths } from "../data/rare-paths";
import { getBiome } from "../data/biomes";

const biome = getBiome("rare-specimens")!;
const subtitle =
  "The universe is stranger than we usually allow ourselves to notice.";
---

<BaseLayout title={biome.title} description={subtitle} hideFooter>
  <section class="hero-arrival biome-room rare-room" aria-label={biome.title}>
    <img
      src="/images/hero-conservatory.png"
      alt=""
      class="hero-arrival__image rare-room__image"
      loading="eager"
    />

    <div class="hero-arrival__title biome-room__copy">
      <p class="biome-room__marker">Rare Specimens</p>
      <h1 class="biome-room__name">{biome.title}</h1>
      <p class="hero-arrival__tagline biome-room__subtitle">{subtitle}</p>
    </div>

    <WingExhibits exhibits={rarePaths} label="Paths through the archive" />
  </section>
</BaseLayout>
