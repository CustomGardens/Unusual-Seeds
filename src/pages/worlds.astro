---
import BaseLayout from "../layouts/BaseLayout.astro";
import WingExhibits from "../components/WingExhibits.astro";
import { worldsPaths } from "../data/worlds-paths";

const subtitle =
  "Stories, futures, and imagined civilizations that help us understand our own world.";
---

<BaseLayout title="House of Imagined Worlds" description={subtitle} hideFooter>
  <section class="hero-arrival biome-room worlds-room" aria-label="House of Imagined Worlds">
    <img
      src="/images/worlds-hero.png"
      alt=""
      class="hero-arrival__image worlds-room__image"
      loading="eager"
    />

    <div class="hero-arrival__title biome-room__copy">
      <p class="biome-room__marker">Wing II · House of Imagined Worlds</p>
      <h1 class="biome-room__name">House of Imagined Worlds</h1>
      <p class="hero-arrival__tagline biome-room__subtitle">{subtitle}</p>
    </div>

    <WingExhibits exhibits={worldsPaths} label="Exhibits in this wing" />
  </section>
</BaseLayout>
