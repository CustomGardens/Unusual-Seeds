---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found">
  <div class="mx-auto max-w-xl px-5 py-20 text-center">
    <h1 class="text-2xl">Not in the archive</h1>
    <p class="mt-4 text-sm text-parchment-muted">This path isn’t on the campus map yet.</p>
    <a href="/" class="mt-8 inline-block text-sm text-accent hover:text-parchment">
      Return home
    </a>
  </div>
</BaseLayout>
