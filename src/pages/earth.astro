---
import BaseLayout from "../layouts/BaseLayout.astro";
import WingExhibits from "../components/WingExhibits.astro";
import { earthPaths } from "../data/earth-paths";

const subtitle =
  "Living systems, cautious climate optimism, and our place on a living planet.";
---

<BaseLayout title="Earth & Ecology" description={subtitle} hideFooter>
  <section class="hero-arrival biome-room earth-room" aria-label="Earth & Ecology">
    <img
      src="/images/earth-hero.png"
      alt=""
      class="hero-arrival__image earth-room__image"
      loading="eager"
    />

    <div class="hero-arrival__title biome-room__copy">
      <p class="biome-room__marker">Earth & Ecology</p>
      <h1 class="biome-room__name">Earth & Ecology</h1>
      <p class="hero-arrival__tagline biome-room__subtitle">{subtitle}</p>
    </div>

    <WingExhibits exhibits={earthPaths} label="Paths through the conservatory" />
  </section>
</BaseLayout>
