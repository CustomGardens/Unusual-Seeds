---
import BaseLayout from "../layouts/BaseLayout.astro";
import WingExhibits from "../components/WingExhibits.astro";
import { futuresPaths } from "../data/futures-paths";
import { getBiome } from "../data/biomes";

const biome = getBiome("conservatory-of-futures")!;
const subtitle =
  "Technology, intelligence, and the futures quietly taking shape.";
---

<BaseLayout title={biome.title} description={subtitle} hideFooter>
  <section
    class="hero-arrival biome-room futures-room"
    aria-label={biome.title}
  >
    <img
      src="/images/hero-observatory.jpeg"
      alt=""
      class="hero-arrival__image futures-room__image"
      loading="eager"
    />

    <div class="hero-arrival__title biome-room__copy">
      <p class="biome-room__marker">Futures</p>
      <h1 class="biome-room__name">{biome.title}</h1>
      <p class="hero-arrival__tagline biome-room__subtitle">{subtitle}</p>
    </div>

    <WingExhibits exhibits={futuresPaths} label="Paths through the observatory" />
  </section>
</BaseLayout>
